# FlowForge production environment reference.
#
# This file documents the production variable surface with NO secret values.
# Real values live in Container Apps secrets, fed from GitHub Actions secrets
# (see docs/DEPLOYMENT.md §9.3 and §10). Never commit a populated copy.
#
# The process that reads each variable is noted in the section headers.

# --- required by the API and the worker -------------------------------------
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>?sslmode=require
HTTP_ADDR=:8080
TOKEN_SECRET=<at-least-32-random-characters>

# --- required by the worker only --------------------------------------------
WORKER_ID=flowforge-worker
WORKER_LEASE_DURATION=10s
WORKER_HEARTBEAT_INTERVAL=2s
# Raised from the 1s default: a quieter lease-recovery sweep lowers the worker's
# steady query load (and its chance of being billed "active"). Worst-case lease
# recovery latency rises from ~11s to ~15s — well inside a portfolio's tolerance.
WORKER_RECOVERY_INTERVAL=5s
# Claim poll cadence. The default is 50ms (20 queries/second when idle). Once
# the worker can scale to zero, a larger value keeps a just-woken worker from
# busy-polling through a delayed-retry backoff window. 500ms is a good default.
WORKER_CLAIM_POLL_INTERVAL=500ms

# --- required by the API only -----------------------------------------------
# Comma-separated browser origins allowed to call the API. Empty = same origin.
# An entry "*.<suffix>" matches any subdomain, used by SWA preview environments.
CORS_ALLOWED_ORIGINS=https://<swa-host>,*.azurestaticapps.net
# Cadence of the control-plane expired-lease recovery sweep. The control plane
# owns recovery so the worker can scale to zero (docs/WORKER_COST_OPTIMIZATION.md).
CONTROL_PLANE_RECOVERY_INTERVAL=5s
MAX_BODY_BYTES=1048576
AUTH_RATE_LIMIT_RPS=10
AUTH_RATE_LIMIT_BURST=20
WEBHOOK_RATE_LIMIT_RPS=20
WEBHOOK_RATE_LIMIT_BURST=40

# --- AI (optional; feature reports itself unavailable when unset) -----------
FLOWFORGE_AI_PROVIDER=openai
FLOWFORGE_OPENAI_API_KEY=
FLOWFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
FLOWFORGE_OPENAI_MODEL=gpt-4o-mini
TRIAL_AI_GENERATION_LIMIT=5
TRIAL_AI_EDIT_LIMIT=5
TRIAL_AI_TOTAL_LIMIT=10

# --- HTTP task credentials (worker; FLOWFORGE_SECRET_<NAME>) ---------------
# FLOWFORGE_SECRET_EXAMPLE=

# --- frontend build only (not read at runtime) ------------------------------
# Compiled into the SPA bundle by `npm run build`. Leave empty for same-origin.
VITE_API_BASE_URL=https://<api-hostname>
