DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge?sslmode=disable
HTTP_ADDR=:8080
DB_CONNECT_TIMEOUT=5s
TOKEN_SECRET=replace-with-at-least-32-random-characters
WORKER_ID=worker-local
# Optional worker tuning (defaults shown). Heartbeat must stay below lease duration.
WORKER_LEASE_DURATION=10s
WORKER_HEARTBEAT_INTERVAL=2s
WORKER_RECOVERY_INTERVAL=1s
# Control-plane limits. MAX_BODY_BYTES rejects oversized request bodies with 413.
# Rate limits are per client IP on the auth and public webhook endpoints.
# Set RPS to 0 to disable a limiter.
MAX_BODY_BYTES=1048576
AUTH_RATE_LIMIT_RPS=10
AUTH_RATE_LIMIT_BURST=20
WEBHOOK_RATE_LIMIT_RPS=20
WEBHOOK_RATE_LIMIT_BURST=40
# Optional AI-assisted workflow generation and editing.
# FLOWFORGE_AI_PROVIDER selects the backend: "openai" (default) or "cohere".
# When the selected provider has no API key the feature is reported as
# unavailable (503) and the UI disables it; there is no fake output. Both keys
# can be present at once - changing FLOWFORGE_AI_PROVIDER switches the backend.
FLOWFORGE_AI_PROVIDER=openai

# OpenAI (also works with any OpenAI-compatible chat-completions endpoint).
# FLOWFORGE_OPENAI_API_KEY=sk-...
# FLOWFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
# FLOWFORGE_OPENAI_MODEL=gpt-4o-mini

# Cohere (v2 chat API).
# FLOWFORGE_COHERE_API_KEY=...
# FLOWFORGE_COHERE_BASE_URL=https://api.cohere.com
# FLOWFORGE_COHERE_MODEL=command-r-plus-08-2024

# Public free trial (no-signup) AI limits. A visitor who enters the trial from
# the landing page or signup page gets a disposable, isolated account with these
# server-enforced AI allowances; registered accounts are never limited. Set any
# value to 0 to disable that cap. The total cap bounds overall cost even when
# the per-kind caps are generous.
TRIAL_AI_GENERATION_LIMIT=5
TRIAL_AI_EDIT_LIMIT=5
TRIAL_AI_TOTAL_LIMIT=10

# Social sign-in (Google and Microsoft). Both are optional, and a provider is
# offered on the sign-in page only when its client ID and secret are both set —
# so local development and a deployment can configure different providers
# independently, and a deployment with no credentials shows no buttons at all
# rather than a broken one. No credential is ever hardcoded.
#
# PUBLIC_BASE_URL is the browser-facing origin of the API. It is used to build
# each provider's callback URL and to send the browser back to the SPA after
# sign-in. It defaults to the Vite dev server, which proxies /api to this API,
# so local development needs only the credentials below. A deployment MUST set
# it (or set each provider's own *_REDIRECT_URL), because a provider cannot
# reach the default origin.
# PUBLIC_BASE_URL=https://api.example.com

# Where the callback hands the browser back to. Defaults to
# PUBLIC_BASE_URL + /auth/callback, which is the SPA route. Set it only when the
# SPA is served from a different origin than the API.
# OAUTH_FRONTEND_REDIRECT_URL=https://app.example.com/auth/callback

# Google. Register <PUBLIC_BASE_URL>/api/v1/auth/oauth/google/callback as an
# authorized redirect URI in the Google Cloud console.
# OAUTH_GOOGLE_CLIENT_ID=...
# OAUTH_GOOGLE_CLIENT_SECRET=...
# OAUTH_GOOGLE_REDIRECT_URL=

# Microsoft. Register <PUBLIC_BASE_URL>/api/v1/auth/oauth/microsoft/callback as
# a redirect URI on the Microsoft Entra app registration. TENANT_ID scopes the
# app: "common" (the default) accepts work/school and personal accounts, while
# "organizations", "consumers", or a directory ID narrows it.
#
# The authorization request asks for exactly `openid profile User.Read`.
# `User.Read` is the only Microsoft Graph permission the app needs: it is what
# authorizes reading the signed-in account's own profile, which is where the
# address comes from (graph.microsoft.com/v1.0/me). `email` is deliberately not
# requested — at Microsoft it is a fourth permission on the consent prompt, and
# the same User.Read token already returns the address. No mail, calendar,
# files, group or directory permission is requested or used. The app
# registration's API permissions should therefore contain only Microsoft Graph
# -> Delegated -> User.Read. See docs/SOCIAL_AUTH_SETUP.md (MS-8).
# OAUTH_MICROSOFT_CLIENT_ID=...
# OAUTH_MICROSOFT_CLIENT_SECRET=...
# OAUTH_MICROSOFT_TENANT_ID=common
# OAUTH_MICROSOFT_REDIRECT_URL=
