{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "*.{css,js,mjs,svg,webp,png,jpg,jpeg,gif,ico,woff,woff2,json,txt,map}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Strict-Transport-Security": "max-age=10886400"
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".svg": "image/svg+xml",
    ".json": "application/json"
  }
}
